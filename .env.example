# ─── Database (Supabase Postgres) ───────────────────────────────────────────
# Settings → Database → Connection string (URI tab) in the Supabase dashboard
DATABASE_URL=

# ─── Supabase Auth / API ────────────────────────────────────────────────────
# Settings → API in the Supabase dashboard
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Same values, exposed to the browser build (Vite requires the VITE_ prefix)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Transactional email ────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Keystone Growth OS <onboarding@resend.dev>
RESEND_OWNER_EMAIL=

# ─── Admin user ──────────────────────────────────────────────────────────────
# The Supabase Auth user id (uuid) that should get the "admin" role on first login
OWNER_OPEN_ID=

NODE_ENV=development
